CREATE TABLE GroupEntity (
    myId TEXT NOT NULL,
    groupId TEXT NOT NULL,
    name TEXT NOT NULL,
    alineCode TEXT NOT NULL,
    PRIMARY KEY (myId, groupId)
);

CREATE TABLE GroupUserEntity (
    myId TEXT NOT NULL,
    groupId TEXT NOT NULL,
    userId TEXT NOT NULL,
    startOffset TEXT,
    alias TEXT,
    isAlarm TEXT,
    userName TEXT NOT NULL,
    pcStatus TEXT,
    phoneNumber TEXT,
    email TEXT,
    birthday TEXT,
    solarLunar TEXT,
    departmentName TEXT,
    positionName TEXT,
    responsibilities TEXT,
    statusMessage TEXT,
    positionCode TEXT,
    positionSortCode TEXT,
    employeeNumber TEXT,
    etcStatus TEXT,
    userType TEXT,
    departmentTopCode TEXT,
    offset21 TEXT,
    offset22 TEXT,
    offset23 TEXT,
    offset24 TEXT,
    offset25 TEXT,
    offset26 TEXT,
    pcMobileStatus TEXT,
    mobileStatus TEXT,
    PRIMARY KEY (myId, userId, groupId),
    FOREIGN KEY (myId, groupId) REFERENCES GroupEntity(myId, groupId) ON DELETE CASCADE
);

-- 그룹마다 멤버를 읽는 조회(myId, groupId)가 쓴다. 기본 키는 userId 가 가운데라 이 조건에 못 쓴다.
CREATE INDEX GroupUserEntity_group ON GroupUserEntity(myId, groupId);

CREATE TABLE OrganDepartmentEntity (
    myId TEXT NOT NULL,
    departmentCode TEXT NOT NULL,
    name TEXT NOT NULL,
    parentsCode TEXT NOT NULL,
    sortPositionCode TEXT NOT NULL,
    departmentTree TEXT NOT NULL,
    departmentLevel TEXT NOT NULL,
    PRIMARY KEY (myId, departmentCode)
);

CREATE TABLE OrganUserEntity (
    myId TEXT NOT NULL,
    userId TEXT NOT NULL,
    classCode TEXT NOT NULL,
    userOffset TEXT,
    userName TEXT NOT NULL,
    positionCode TEXT,
    positionName TEXT,
    isBasicClass TEXT,
    pcStatus TEXT,
    phoneNumber TEXT,
    email TEXT,
    positionSortCode TEXT,
    employeeNumber TEXT,
    userSortCode TEXT,
    userType TEXT,
    parentClassCode TEXT,
    dummy15 TEXT,
    dummy16 TEXT,
    dummy17 TEXT,
    dummy18 TEXT,
    dummy19 TEXT,
    dummy20 TEXT,
    etcPresenceStatus TEXT,
    statusMessage TEXT,
    pcMobileStatus TEXT,
    mobileStatus TEXT,
    userFullName TEXT,
    departmentName TEXT,
    responsibilities TEXT,
    organ28 TEXT,
    organ29 TEXT,
    organ30 TEXT,
    organ31 TEXT,
    organ32 TEXT,
    organ33 TEXT,
    organ34 TEXT,
    organ35 TEXT,
    organ36 TEXT,
    birthday TEXT,
    organ38 TEXT,
