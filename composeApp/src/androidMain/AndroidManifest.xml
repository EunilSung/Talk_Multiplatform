<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- FCM 알림 권한 (Android 13+, API 33). 하위 버전은 자동으로 무시됨. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 화면 잠금 생체인증 (지문/얼굴 — BiometricPrompt) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- 카메라 / 갤러리 / 파일 picker (ImagePickerKMP) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Android 13+ (API 33) — 세분화된 미디어 권한 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 12 이하 — 레거시 외부 저장소 권한 (maxSdk 로 신버전에서는 자동 비적용) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 강제 업데이트 — APK 다운로드 후 자동 설치 트리거 (Android 8+). 시스템이 "알 수 없는 출처"
         사용자 동의 다이얼로그를 자동으로 띄움. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <!-- 다운로드 첨부를 열 수 있는 연결 프로그램 조회용. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name="com.eunilsung.talk.MyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.App">
        <activity
            android:exported="true"
            android:name="com.eunilsung.talk.MainActivity"
            android:theme="@style/Theme.App.Starting"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|layoutDirection|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                외부 앱 공유 시트 진입점.
                  - ACTION_SEND        : 단일 텍스트 / 단일 파일 공유 (EXTRA_TEXT 또는 EXTRA_STREAM)
                  - ACTION_SEND_MULTIPLE : 다중 파일 공유 (EXTRA_STREAM = ArrayList<Uri>)
                  - MIME 타입: 텍스트 / 이미지 / 비디오 / 그 외 (*/* 가 PDF·문서 등 매칭)
                singleTask launchMode 라 이미 실행 중이면 onNewIntent 로 진입.
                MainActivity.handleShareIntent 가 EXTRA_TEXT / EXTRA_STREAM 을 파싱해
                PendingShareNavigation.set() 호출 → 앱 root 가 라우팅.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging — 토큰 발급 / 메시지 수신 진입점. -->
        <service
            android:name="com.eunilsung.talk.data.remote.push.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- 다운로드한 첨부를 연결 프로그램으로 넘길 때 file:// 대신 content:// 를 쓰기 위함. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>