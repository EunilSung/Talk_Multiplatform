<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 공유 경로.

    '열기'는 받은 첨부를 앱 cache 의 open_files 폴더에 사본으로 두고 그 사본만 다른 앱에 넘긴다(content://).
    다른 앱에 내줄 수 있는 범위를 그 폴더로 좁힌다 — 외부 저장소 루트·앱 files·cache 전체를 내주지 않는다.

    my_images 는 ImagePickerKMP 가 자기 FileProvider 에 쓰는 이름 그대로다. 그 라이브러리도 같은 이름(@xml/file_paths)의
    이 파일을 읽으므로, 라이브러리가 쓰는 앱 전용 외부 Pictures 폴더만 남긴다.
-->
<paths>
    <cache-path name="open_files" path="open_files/" />
    <external-files-path name="my_images" path="Pictures" />
</paths>
