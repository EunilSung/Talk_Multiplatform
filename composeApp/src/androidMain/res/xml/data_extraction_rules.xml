<?xml version="1.0" encoding="utf-8"?>
<!--
  앱 데이터를 기기 밖으로 내보내지 않는다 (Android 12+).

  `allowBackup="false"` 는 클라우드 백업을 막지만, **기기 간 이전(device-transfer)** 은 이 파일로 따로
  통제된다. 둘 다 막지 않으면 로컬 DB 와 저장된 로그인 정보가 새 기기로 그대로 넘어간다.

  `root` 하나만 빼도 하위가 모두 걸리지만, 도메인을 다 적어 둔다 — 나중에 누가 `include` 를 추가할 때
  무엇이 대상인지 한눈에 보이게 하려는 것이다.

  로컬 DB 본문은 Keystore 키로 잠겨 있고 그 키는 백업에 따라가지 않는다. 그래서 백업이 복원되면
  예전 대화가 빈 말풍선으로 남는데, 여기서 복원 자체를 막으므로 그 상태에 들어가지 않는다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
