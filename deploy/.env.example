# 서버의 ~/talk/.env 로 복사해 채운다. 이 파일 말고 .env 는 저장소에 올리지 않는다.
# HTTPS 인증서를 받을 도메인. 도메인이 없으면 <공인IP>.sslip.io 를 쓴다
DOMAIN=
# PostgreSQL 비밀번호. openssl rand -hex 24 로 만든다
DB_PASSWORD=
# 선택 — 비우면 AI 만 꺼진다
GEMINI_API_KEY=
AI_MODEL=
# 선택 — Firebase 서비스 계정 JSON 을 base64 한 줄로. 비우면 푸시만 꺼진다
FIREBASE_CREDENTIALS_B64=
