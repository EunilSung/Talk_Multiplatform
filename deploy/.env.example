# 서버의 ~/talk/.env 로 복사해 채운다. 이 파일 말고 .env 는 저장소에 올리지 않는다.
# HTTPS 인증서를 받을 도메인. 도메인이 없으면 <공인IP>.sslip.io 를 쓴다
DOMAIN=
# PostgreSQL 비밀번호. openssl rand -hex 24 로 만든다
DB_PASSWORD=
# 선택 — 비우면 AI 만 꺼진다
GEMINI_API_KEY=
AI_MODEL=
# 선택 — Firebase 서비스 계정 JSON 을 base64 한 줄로. 비우면 푸시만 꺼진다
FIREBASE_CREDENTIALS_B64=
# 선택 — 시연용 계정 test1~test10. 둘 다 있어야 만든다. 기본 비밀번호는 없다(저장소에 적힌 로컬용 비밀번호를 쓰지 않는다)
# SEED_PASSWORD 는 openssl rand -hex 12 로 만든다. 이미 있는 시연용 계정도 다시 띄울 때 이 비밀번호로 바뀐다
# 둘 중 하나라도 비우면 계정을 만들지 않는다. 예전에 만든 계정은 예전 비밀번호 그대로 남으니 이 값으로 바꾸거나 DB 에서 지운다
SEED_DEMO_ACCOUNTS=
SEED_PASSWORD=
