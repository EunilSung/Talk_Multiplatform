# DOMAIN 으로 Let's Encrypt 인증서를 받아 HTTPS 를 붙인다. WebSocket 도 그대로 넘어간다.
# 같은 인스턴스의 다른 앱은 ~/caddy-sites 에 자기 사이트 파일을 두고 공용 네트워크 edge 로 붙는다.
import /etc/caddy/sites/*.caddy

# 본문 크기는 경로마다 따로 묶는다. 파일 올리기만 크고(서버 한도 20MB 에 여유를 둔 25MB), 나머지는 작은 JSON 이다.
# 서버도 같은 한도를 다시 보지만, 큰 본문이 서버까지 오지 않게 여기서 먼저 끊는다.
{$DOMAIN} {
	encode gzip
	@upload path_regexp ^/rooms/[^/]+/files$
	@other not path_regexp ^/rooms/[^/]+/files$
	request_body @upload {
		max_size 25MB
	}
	request_body @other {
		max_size 1MB
	}
	reverse_proxy talk-server:8080
}
